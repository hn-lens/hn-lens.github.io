{
  "name": "hacker-lens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A static, in-browser personalized Hacker News reader with local + optional cloud AI summaries. No backend; everything runs in the browser.",
  "author": "Jianling Zhong",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hn-lens/hn-lens.github.io.git"
  },
  "homepage": "https://hn-lens.github.io",
  "bugs": {
    "url": "https://github.com/hn-lens/hn-lens.github.io/issues"
  },
  "keywords": [
    "hacker-news",
    "reader",
    "react",
    "vite",
    "personalization",
    "webllm",
    "static-site"
  ],
  "scripts": {
    "prepare": "node scripts/arm-hooks.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && SINGLEFILE=1 vite build --outDir dist-single --emptyOutDir && node scripts/inline.mjs dist-single",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:ui": "node scripts/uitest.mjs",
    "test:models": "node scripts/modeltest.mjs",
    "test:eval": "node scripts/evaltest.mjs",
    "test:persist": "node scripts/persisttest.mjs",
    "test:wiring": "node scripts/uiwiring.mjs",
    "test:stress": "node scripts/stress.mjs",
    "test:reach": "node scripts/reachtest.mjs",
    "test:read": "node scripts/readtest.mjs",
    "test:personalizelive": "node scripts/personalizeliveupdatetest.mjs",
    "test:favicon": "node scripts/favicontest.mjs",
    "test:readstate": "node scripts/readstatetest.mjs",
    "test:feedstability": "node scripts/feedstabilitytest.mjs",
    "test:filter": "node scripts/filtertest.mjs",
    "test:toast": "node scripts/toasttest.mjs",
    "test:audit": "node scripts/audit.mjs",
    "test:edge": "node scripts/edgetest.mjs",
    "test:extreme": "node scripts/extremetest.mjs",
    "test:a11y": "node scripts/a11ytest.mjs",
    "test:dialogreach": "node scripts/dialogreachtest.mjs",
    "test:leakself": "node scripts/leakcheckselftest.mjs",
    "test:layout": "node scripts/layouttest.mjs",
    "test:comments": "node scripts/commenttest.mjs",
    "test:discussionview": "node scripts/discussionviewtest.mjs",
    "test:topcomment": "node scripts/topcommenttest.mjs",
    "test:llmcache": "node scripts/llmcachetest.mjs",
    "test:articleproxy": "node scripts/articleproxytest.mjs",
    "test:articleranking": "node scripts/articlerankingtest.mjs",
    "test:articlelink": "node scripts/articlelinktest.mjs",
    "test:refresh": "node scripts/refreshtest.mjs",
    "test:datamgmt": "node scripts/datamgmttest.mjs",
    "test:keyboard": "node scripts/keyboardtest.mjs",
    "test:hnaccount": "node scripts/hnaccounttest.mjs",
    "test:weighthints": "node scripts/weighthintstest.mjs",
    "test:rankergate": "node scripts/rankergatetest.mjs",
    "test:autotraingate": "node scripts/autotraingatetest.mjs",
    "test:diversity": "node scripts/diversitytest.mjs",
    "test:cardteach": "node scripts/cardteachtest.mjs",
    "test:mobile": "node scripts/mobiletest.mjs",
    "test:onboarding": "node scripts/onboardingtest.mjs",
    "test:gist": "node scripts/gisttest.mjs",
    "test:headerfit": "node scripts/headerfittest.mjs",
    "test:contentbudget": "node scripts/contentbudgettest.mjs",
    "test:themecontrast": "node scripts/themecontrasttest.mjs",
    "test:switch": "node scripts/switchtest.mjs",
    "test:visual": "node scripts/visualtest.mjs",
    "test:personalization": "node scripts/personalization.mjs",
    "test:quick": "node scripts/test.mjs quick",
    "test:full": "node scripts/test.mjs full",
    "themes:gallery": "node scripts/themegallery.mjs",
    "verify": "node scripts/test.mjs standard"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@mlc-ai/web-llm": "^0.2.84",
